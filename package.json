{
  "name": "ecommerce",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm install --prefix server",
    "dev": "vite",
    "server": "npm start --prefix server",
    "start": "concurrently -k -n server,web \"npm run server\" \"npm run dev\"",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "vite": "^8.3.1"
  }
}
